{
  "name": "marksman-api",
  "version": "1.0.0",
  "description": "An API to access Marksman bounties and all related data.",
  "license": "ISC",
  "author": "psehr",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:cancellation": "tsx --test tests/bounty-cancellation.test.ts",
    "test:funding": "tsx --test tests/bounty-funding.test.ts",
    "test:users": "tsx --test tests/users.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:osu": "tsx --test tests/osu.test.ts",
    "db:test:start": "docker compose -p marksman-api-tests -f compose.test.yaml up -d --wait",
    "db:test:stop": "docker compose -p marksman-api-tests -f compose.test.yaml down",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:start": "docker compose up -d",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json",
    "predev": "npm --prefix .. run build:contracts",
    "prebuild": "npm --prefix .. run build:contracts",
    "pretest": "npm --prefix .. run build:contracts",
    "pretest:cancellation": "npm --prefix .. run build:contracts",
    "pretest:funding": "npm --prefix .. run build:contracts",
    "pretest:users": "npm --prefix .. run build:contracts",
    "pretest:auth": "npm --prefix .. run build:contracts",
    "pretest:osu": "npm --prefix .. run build:contracts",
    "pretypecheck": "npm --prefix .. run build:contracts",
    "test:verification": "tsx --test tests/bounty-verification.test.ts",
    "test:completion": "tsx --test tests/bounty-completion.test.ts",
    "pretest:verification": "npm --prefix .. run build:contracts",
    "pretest:completion": "npm --prefix .. run build:contracts"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.0",
    "zod": "^4.6.2",
    "@marksman/contracts": "0.1.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": true
}
